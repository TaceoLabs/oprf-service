# Reproducible build of the OPRF key-gen image on StageX (https://stagex.tools).
#
# StageX is a full-source-bootstrapped musl/LLVM toolchain distributed as
# digest-pinned, multi-maintainer-signed OCI images. Every input below is pinned
# by digest, the build runs offline after `cargo fetch`, and the resulting image
# manifest digest is a function of the git commit and the target platform.
#
# Platforms: linux/amd64 and linux/arm64. StageX only publishes amd64 images, so
# every build stage runs on amd64 (emulated on other hosts) and arm64 is
# cross-compiled; see the toolchain-arm64 stage.
#
# To reproduce a published image, use the commands in the "Build and Push" run
# summary: they set up the pinned BuildKit (BUILDKIT_IMAGE in
# .github/workflows/build-and-push.yml) and pass the workflow's labels, which
# are part of the image config.
#
# Build without those labels, e.g. to compare two local builders (matches the
# other builder, not the published digest):
#   SOURCE_DATE_EPOCH=$(git log -1 --pretty=%ct) docker buildx build \
#     --platform linux/amd64 --provenance=false --sbom=false --no-cache \
#     --build-arg GIT_HASH=$(git rev-parse HEAD) \
#     --output type=oci,dest=out,tar=false,rewrite-timestamp=true,force-compression=true \
#     -f build/Dockerfile.oprf-key-gen .
#
# StageX release sx2026.11.0 (Rust 1.97.1). Bump all digests together.
FROM --platform=linux/amd64 docker.io/stagex/pallet-rust:sx2026.11.0@sha256:4f12174acd7ccab9506e20a986c556cd5837dbd0ce616abf3031bcaaaa365590 AS pallet-rust
FROM --platform=linux/amd64 docker.io/stagex/core-cmake:sx2026.11.0@sha256:75ab41e96e7142fbe667e36f482858ce190d3fe5e2bb29835cf1b153cff74d34 AS core-cmake
FROM --platform=linux/amd64 docker.io/stagex/core-make:sx2026.11.0@sha256:224e0158be845e591c1ebfedc3bda2495e7b45efff94674f9c5d6d8b08a59918 AS core-make
FROM --platform=linux/amd64 docker.io/stagex/core-ca-certificates:sx2026.11.0@sha256:2e5d0da04413dfbc739f3009fe6616e90e733c463f8495ce6997b02c0832735c AS core-ca-certificates
# arm64 builds of the same StageX recipes (musl 1.2.6, LLVM 22.1.8), published
# by https://github.com/siderolabs/stagex; StageX itself publishes amd64 only.
# Only target libraries are taken from these, nothing is executed.
FROM --platform=linux/arm64 ghcr.io/siderolabs/stagex/core-musl:2026.09.0@sha256:e6c75fa4bc20a90503a25eea64c7d49e3d25f024736f5ccd9461ed615f107a89 AS musl-arm64
FROM --platform=linux/arm64 ghcr.io/siderolabs/stagex/core-llvm:2026.09.0@sha256:9b815cc2f56804ebc846bba8e95502b29ad3cb5bf6888a6d5f981beb97448213 AS llvm-arm64

FROM pallet-rust AS toolchain
# cmake + make for aws-lc-sys (cmake) and tikv-jemalloc-sys (autotools).
# aws-lc-sys ships pregenerated bindings for both musl targets, so
# neither bindgen/libclang nor perl is needed.
COPY --from=core-cmake . /
COPY --from=core-make . /
# The pallet provides clang/lld/mold but only exports CC & co. via /etc/profile
# (login shells). Set them explicitly so cc-rs, cmake and configure agree.
ENV CC=clang CXX=clang++ AR=llvm-ar RANLIB=llvm-ranlib \
    TZ=UTC LC_ALL=C \
    CARGO_HOME=/cargo
# Pin every value jemalloc's configure would otherwise probe from the build host.
# LG_PAGE=14 keeps the binary usable on 4 KiB and 16 KiB page kernels (see git
# history); LG_VADDR is cpuid-detected on x86_64 (48 vs 57 on LA57 hosts);
# LG_HUGEPAGE is read from /sys. GIT_CEILING_DIRECTORIES stops configure from
# `git describe`-ing the repo into the allocator's version string (search
# stops at the target dir; .git is also excluded via .dockerignore).
ENV JEMALLOC_SYS_WITH_LG_PAGE=14 \
    JEMALLOC_SYS_WITH_LG_VADDR=48 \
    JEMALLOC_SYS_WITH_LG_HUGEPAGE=21 \
    GIT_CEILING_DIRECTORIES=/app/target
# StageX's musl target defaults to dynamic linking; crt-static restores fully
# static binaries. build-id=none removes the linker's build-id note.
ENV RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-Wl,--build-id=none"
# SOURCE_DATE_EPOCH=1 and CARGO_INCREMENTAL=0 are preset by the pallet.

FROM toolchain AS toolchain-amd64
ENV TARGET=x86_64-unknown-linux-musl

# The pallet has clang/lld with the AArch64 backend and rust-src, but no aarch64
# target libraries. libc, crt objects, compiler-rt and libunwind come from the
# arm64 StageX packages built by Sidero Labs' CI; Rust std is built here.
FROM toolchain AS toolchain-arm64
ENV TARGET=aarch64-unknown-linux-musl
COPY --from=musl-arm64 / /opt/aarch64/
COPY --from=llvm-arm64 /usr/lib/libunwind.a /opt/aarch64/usr/lib/
COPY --from=llvm-arm64 /usr/lib/clang/22/lib/${TARGET}/ /usr/lib/clang/22/lib/${TARGET}/
RUN --network=none <<'EOF'
set -eux
SYSROOT=/opt/aarch64
RT=/usr/lib/clang/22/lib/${TARGET}
RL=/usr/lib/rustlib/${TARGET}/lib

# Makes `clang --target=aarch64-unknown-linux-musl` a working cross compiler
# and linker driver for cc-rs, cmake and autoconf without further flags.
printf -- '--sysroot=%s\n-fuse-ld=lld\n' ${SYSROOT} > /usr/bin/${TARGET}.cfg

# Rust std from the pallet's rust-src (build-std is unstable, hence
# RUSTC_BOOTSTRAP; the application build below is plain stable cargo).
# StageX strips *.orig from the vendored std deps, which leaves stale file
# checksums behind; clear them.
mkdir -p /src/std/src && cd /src/std
cp -r /usr/lib/rustlib/src/rust/library/vendor vendor
sed -i 's/"files":{[^}]*}/"files":{}/' vendor/*/.cargo-checksum.json
printf '[package]\nname = "sysroot"\nversion = "0.0.0"\nedition = "2024"\n' > Cargo.toml
touch src/lib.rs
RUSTC_BOOTSTRAP=1 cargo build --offline --release -Zbuild-std=std,panic_abort --target ${TARGET} \
    --config 'profile.release.codegen-units=1' \
    --config 'source.crates-io.replace-with="vendor"' --config 'source.vendor.directory="vendor"'
rm target/${TARGET}/release/deps/libsysroot-*
mkdir -p ${RL}/self-contained
cp target/${TARGET}/release/deps/*.rlib ${RL}/
# Same layout as the pallet's x86_64 target: rustc links crt-static musl
# binaries with the crt objects from self-contained/.
for f in crt1.o rcrt1.o Scrt1.o crti.o crtn.o; do cp ${SYSROOT}/usr/lib/$f ${RL}/self-contained/; done
for f in crtbegin crtend; do
    cp ${RT}/clang_rt.$f.o ${RL}/self-contained/$f.o
    cp ${RT}/clang_rt.$f.o ${RL}/self-contained/${f}S.o
done
rm -rf /src
EOF
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=clang \
    RUSTFLAGS="${RUSTFLAGS} -C link-arg=--target=aarch64-unknown-linux-musl"

FROM toolchain-${TARGETARCH} AS builder
# Compiled into the binary via `nodes_common::version_info!()` (served on
# /version). .git is not in the build context, so without this the fallback
# `git describe` yields UNKNOWN. A function of the commit, hence deterministic.
ARG GIT_HASH
WORKDIR /app
# look at .dockerignore if this does not copy what you want
COPY . .
# Fetch with network, build without. --target is required so RUSTFLAGS do not
# apply to proc-macros and build scripts (crt-static breaks proc-macro dylibs).
RUN cargo fetch --locked --target "${TARGET}"
RUN --network=none cargo build --frozen --locked --profile reproducible \
    --target "${TARGET}" --bin taceo-oprf-key-gen \
    && cp "target/${TARGET}/reproducible/taceo-oprf-key-gen" /taceo-oprf-key-gen

# Files copied from the build context keep the host's mode (umask) and mtime,
# and rewrite-timestamp only clamps mtimes newer than SOURCE_DATE_EPOCH, so an
# old checkout leaks its date into the layer. Normalise both here.
FROM pallet-rust AS artifacts
COPY ./artifacts/OPRFKeyGen.13.arks.zkey ./artifacts/OPRFKeyGenGraph.13.bin \
    ./artifacts/OPRFKeyGen.25.arks.zkey ./artifacts/OPRFKeyGenGraph.25.bin \
    /artifacts/
RUN chmod 0644 /artifacts/* && touch -d @0 /artifacts/*

FROM scratch AS runtime
ARG GIT_HASH
LABEL org.opencontainers.image.revision=$GIT_HASH
LABEL org.opencontainers.image.vendor=TACEO
LABEL org.opencontainers.image.source=https://github.com/TaceoLabs/oprf-service
LABEL org.opencontainers.image.description="OPRF key gen"
WORKDIR /app
USER 65532:65532

COPY --from=artifacts /artifacts/ /app/
COPY --from=builder /taceo-oprf-key-gen /app/taceo-oprf-key-gen
COPY --from=core-ca-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENTRYPOINT [ "/app/taceo-oprf-key-gen" ]
